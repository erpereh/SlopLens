# SlopLens local API
PORT=3001
NODE_ENV=development

# PostgreSQL / Supabase Local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Local
# Get the current local values with: pnpm supabase status
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Decision provider: Jev through Vercel AI Gateway
# These values are bootstrap defaults only, not domain hardcoding.
DECISION_PROVIDER=jev
DECISION_MODEL=typesafe-ai/jev
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev

# Provider defaults
# These values are only the initial local-development defaults.
# SlopLens is provider-agnostic and will allow changing providers/models
# from the app without editing this file.
EMBEDDING_PROVIDER=openrouter
SEARCH_PROVIDER=tavily
VISION_PROVIDER=openrouter
REASONING_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
VISION_MODEL=inclusionai/ling-3.0-flash-vl:free

# Tavily
TAVILY_API_KEY=
