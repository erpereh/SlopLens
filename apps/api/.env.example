# SlopLens local API
PORT=3001
NODE_ENV=development

# PostgreSQL / Supabase Local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Local
# Get the current local values with: pnpm supabase status
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Decision provider: Jev through Vercel AI Gateway
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev

# Provider selection
EMBEDDING_PROVIDER=local
SEARCH_PROVIDER=
VISION_PROVIDER=
REASONING_PROVIDER=

# Optional provider credentials.
# Leave empty unless the corresponding provider is enabled.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
